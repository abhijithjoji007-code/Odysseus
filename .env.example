ASSISTANT_NAME=Odysseus
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_MODEL=gemini-flash-latest
# Folder Odysseus should inspect for Project Intelligence missions.
# Keep the default to analyze Odysseus itself, or paste another absolute Windows folder path.
PROJECT_SCAN_PATH=.
PROJECT_SEARCH_ROOTS=C:\Users\DELL\Projects;C:\Users\DELL\Documents

# Optional: semicolon-separated extra folders for file search.
# Desktop, Documents, Downloads, and PROJECT_SCAN_PATH are searched automatically.
FILE_SEARCH_ROOTS=C:\Users\DELL\College;C:\Users\DELL\Projects
